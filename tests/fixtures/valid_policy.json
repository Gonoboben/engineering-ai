{
  "schema_version": "1.0",
  "policy_version": "1.0",
  "project_id": "engineering-ai",
  "autonomous_actions": [
    "read_repository",
    "search_documents",
    "run_calculation",
    "run_simulation",
    "run_validator",
    "propose_patch"
  ],
  "approval_required_actions": [
    "architecture_change",
    "physics_change",
    "destructive_action",
    "fabrication_authorization",
    "release_authorization",
    "external_disclosure",
    "scope_expansion"
  ],
  "forbidden_actions": ["validator_weakening"],
  "mandatory_validators": ["schema-suite"],
  "stop_conditions": [
    "authoritative source conflict",
    "approval boundary reached",
    "required validator failure"
  ],
  "retry_limit": 3
}
