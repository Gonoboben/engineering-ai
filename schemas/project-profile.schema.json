{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonoboben.github.io/engineering-ai/schemas/project-profile.schema.json",
  "title": "Engineering AI Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "display_name",
    "repository",
    "authoritative_files",
    "policy_ref",
    "tool_profiles"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "display_name": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_path", "default_branch"],
      "properties": {
        "local_path": {"type": "string", "minLength": 1},
        "remote": {"type": ["string", "null"]},
        "default_branch": {"type": "string", "minLength": 1}
      }
    },
    "authoritative_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "policy_ref": {"type": "string", "minLength": 1},
    "architecture_baseline": {"type": ["string", "null"]},
    "tool_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
