{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonoboben.github.io/engineering-ai/schemas/retrieval-context.schema.json",
  "title": "Engineering AI Retrieval Context Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "query_text",
    "status",
    "candidate_count",
    "relevant_count",
    "items",
    "omitted_due_to_result_limit",
    "omitted_due_to_context_budget",
    "total_context_chars",
    "include_advisory",
    "include_proposed_adrs",
    "include_history",
    "semantic_vector_backend",
    "automatic_context_injection"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "query_text": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["READY", "NO_RELEVANT_CONTEXT", "BUDGET_EXHAUSTED"]
    },
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 100},
    "relevant_count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "memory_id",
          "revision",
          "kind",
          "authority",
          "validation_class",
          "decision_status",
          "physical_validation_state",
          "title",
          "summary",
          "content",
          "provenance",
          "evidence_refs",
          "source_refs",
          "content_sha256",
          "relevance_score",
          "matched_terms",
          "is_latest_revision"
        ],
        "properties": {
          "record_id": {"type": "string", "minLength": 3},
          "memory_id": {"type": "string", "minLength": 3},
          "revision": {"type": "integer", "minimum": 1},
          "kind": {
            "type": "string",
            "enum": ["ADR", "CALCULATION", "TEST_RESULT", "FAILURE_LESSON", "SOURCE_REFERENCE"]
          },
          "authority": {
            "type": "string",
            "enum": ["HUMAN", "SUPERVISOR", "MODEL", "DETERMINISTIC_TOOL", "IMPORTED_SOURCE"]
          },
          "validation_class": {
            "type": "string",
            "enum": ["CONTROL", "ADVISORY", "SOURCE", "CALCULATION", "SIMULATION", "DETERMINISTIC_TEST", "PHYSICAL"]
          },
          "decision_status": {
            "oneOf": [
              {"type": "string", "enum": ["PROPOSED", "ACCEPTED"]},
              {"type": "null"}
            ]
          },
          "physical_validation_state": {
            "type": "string",
            "enum": ["PHYSICAL_NOT_EXECUTED", "PHYSICAL_PASS", "PHYSICAL_FAIL", "NOT_APPLICABLE"]
          },
          "title": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "content": {"type": "object"},
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relevance_score": {"type": "integer", "minimum": 1},
          "matched_terms": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "is_latest_revision": {"type": "boolean"}
        }
      }
    },
    "omitted_due_to_result_limit": {"type": "integer", "minimum": 0},
    "omitted_due_to_context_budget": {"type": "integer", "minimum": 0},
    "total_context_chars": {"type": "integer", "minimum": 0, "maximum": 100000},
    "include_advisory": {"type": "boolean"},
    "include_proposed_adrs": {"type": "boolean"},
    "include_history": {"type": "boolean"},
    "semantic_vector_backend": {"const": "DEFERRED_NOT_JUSTIFIED"},
    "automatic_context_injection": {"const": false}
  }
}
