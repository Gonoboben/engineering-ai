{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gonoboben.github.io/engineering-ai/schemas/project-policy.schema.json",
  "title": "Engineering AI Project Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "project_id",
    "autonomous_actions",
    "approval_required_actions",
    "forbidden_actions",
    "mandatory_validators",
    "stop_conditions",
    "retry_limit"
  ],
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "read_repository",
        "search_documents",
        "run_calculation",
        "run_simulation",
        "run_validator",
        "propose_patch",
        "write_worktree",
        "local_commit",
        "push_remote",
        "open_pr",
        "merge_pr",
        "release_authorization",
        "fabrication_authorization",
        "architecture_change",
        "physics_change",
        "validator_weakening",
        "external_disclosure",
        "destructive_action",
        "scope_expansion"
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "autonomous_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "approval_required_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "forbidden_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    },
    "mandatory_validators": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "retry_limit": {"type": "integer", "minimum": 0, "maximum": 20}
  }
}
